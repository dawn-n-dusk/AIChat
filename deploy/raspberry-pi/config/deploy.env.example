# Copy this file to deploy.env, review every value, and keep deploy.env private.
# This file contains no relay bearer token.

AICHAT_SOURCE_ROOT=/absolute/path/to/AIChat
AICHAT_RELEASE_ID=manual-YYYYMMDD-HHMMSS
AICHAT_PYTHON=python3

# The Relay bind address is intentionally not configurable: systemd always uses
# 127.0.0.1. Port 8787 avoids the existing gohttpserver listener on port 8000.
AICHAT_RELAY_PORT=8787
AICHAT_DB_PATH=/var/lib/aichat-relay/relay.db
AICHAT_BACKUP_DIR=/var/backups/aichat-relay
AICHAT_BACKUP_RETENTION_DAYS=14

# Fail-closed single-process production profile. These values are deliberately
# explicit so an installation does not depend on implicit application defaults.
AICHAT_PRODUCTION_LOCKDOWN=true
AICHAT_DOCS_ENABLED=false
AICHAT_AGENT_REGISTRATION_ENABLED=false
AICHAT_CHANNEL_CREATE_ENABLED=false
AICHAT_CHANNEL_JOIN_ENABLED=false
AICHAT_HTTP_RATE_LIMIT_PER_MINUTE=120
AICHAT_WS_HANDSHAKE_RATE_LIMIT_PER_MINUTE=30
AICHAT_WS_MAX_CONNECTIONS=128
AICHAT_WS_MAX_CONNECTIONS_PER_AGENT=4
AICHAT_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Production bootstrap: provide a consistent SQLite snapshot produced by the
# SQLite backup API, optionally gzip-compressed. On a first install the script
# refuses to create an empty identity database while REQUIRE_SEED_DB is true.
AICHAT_REQUIRE_SEED_DB=true
AICHAT_SEED_DB=/secure/transfer/relay-consistent.sqlite3.gz

# Existing shared Caddy installation on the Raspberry Pi.
AICHAT_DOMAIN=dawnndusk-rustdesk.duckdns.org
AICHAT_PATH_PREFIX=/aichat
AICHAT_PUBLIC_BASE_URL=https://dawnndusk-rustdesk.duckdns.org/aichat
# Keep registration closed on the public route after initial identities exist.
# Temporarily opening it is not recommended; use an SSH tunnel over Tailscale.
AICHAT_PUBLIC_PROVISIONING=false
AICHAT_CADDY_BINARY=/opt/caddy-hk/bin/caddy
AICHAT_CADDY_CONFIG=/opt/caddy-hk/Caddyfile
AICHAT_CADDY_SERVICE=caddy-hk.service

# The managed AIChat route is inserted immediately before this existing,
# whitespace-trimmed fallback line. Installation fails unless it occurs once.
AICHAT_CADDY_FALLBACK="reverse_proxy 127.0.0.1:17300"
